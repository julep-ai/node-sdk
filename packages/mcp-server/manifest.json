{
  "dxt_version": "0.2",
  "name": "@julep/sdk-mcp",
  "version": "2.7.4",
  "description": "The official MCP Server for the Julep API",
  "author": {
    "name": "Julep",
    "email": "developers@julep.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julep-ai/node-sdk.git"
  },
  "homepage": "https://github.com/julep-ai/node-sdk/tree/main/packages/mcp-server#readme",
  "documentation": "https://docs.julep.ai/",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "JULEP_API_KEY": "${user_config.JULEP_API_KEY}"
      }
    }
  },
  "user_config": {
    "JULEP_API_KEY": {
      "title": "api_key",
      "description": "",
      "required": true,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
